          "id": "column-13",
          "items": [
            {
              "id": "text-15",
              "kind": "text",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "Grade 12 Titanium Applications:"
                },
                {
                  "type": "paragraph",
                  "text": "Shell and heat exchangers"
                },
                {
                  "type": "paragraph",
                  "text": "Hydrometallurgical applications"
                },
                {
                  "type": "paragraph",
                  "text": "Elevated temperature chemical manufacturing"
                },
                {
                  "type": "paragraph",
                  "text": "Marine and airfare components"
                }
