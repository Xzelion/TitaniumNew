            {
              "id": "text-14",
              "kind": "text",
              "blocks": [
                {
                  "type": "heading",
                  "level": 2,
                  "text": "AMS 2630"
                },
                {
                  "type": "paragraph",
                  "text": "Cobalt-chrome-molybdenum (CCM) Grade: 1537"
                },
                {
                  "type": "paragraph",
                  "text": "Scope: Inspection, Ultrasonic Product Over 0.5 Inch (12.7 mm) Thick"
                },
                {
                  "type": "paragraph",
                  "text": "Description: This specification covers procedures for ultrasonic inspection, by pulse-echo procedures, of flat, rectangular, round, cylindrical, and contoured products having a thickness or cross-sectional dimension greater than 0.5 inch (12.7 mm), using either contact or immersion methods, and using the longitudinal-wave or shear-wave modes or combinations of the two, as necessary. This specification may apply to testing finished machined parts provided the parts can meet the basic testability requirements, such as size, contour, metallurgical structure, and thickness."
                },
                {
                  "type": "paragraph",
                  "text": "Product availability:"
                },
                {
                  "type": "paragraph",
                  "text": "[Cobalt Chrome Grade 1537 Round Bar](https://qqa.titanium.com/product/mill-product-cobalt-chrome-moly-round-bar)"
                },
                {
                  "type": "paragraph",
                  "text": "DISCLAIMER: The use of this information should be considered strictly voluntary. Information contained in this page or across the domain, may contain typographical errors and are for reference only. Information presented are purely generalizations and are not a substitution for AMS specifications."
                },
                {
                  "type": "paragraph",
                  "text": "CHEMICAL COMPOSITION"
                },
                {
                  "type": "paragraph",
                  "text": "C 0.14% Max"
                },
                {
                  "type": "paragraph",
                  "text": "Si 1.0% Max"
                },
                {
                  "type": "paragraph",
                  "text": "Mn 1.0% Max"
                },
                {
                  "type": "paragraph",
                  "text": "Cr 26.0 – 30.0%"
                },
                {
                  "type": "paragraph",
                  "text": "Mo 5.0 – 7.0%"
                },
                {
                  "type": "paragraph",
                  "text": "Ni 1.0% Max"
                },
                {
                  "type": "paragraph",
                  "text": "Fe 0.75% Max"
                },
                {
                  "type": "paragraph",
                  "text": "N 0.25% Max"
                },
                {
                  "type": "paragraph",
                  "text": "Co Balance"
                },
                {
                  "type": "paragraph",
                  "text": "Mechanical Properties"
                },
                {
                  "type": "paragraph",
                  "text": "Hardness: 40 HRC"
                },
                {
                  "type": "paragraph",
                  "text": "Yield Strength (Mpa): 827 min"
                },
                {
                  "type": "paragraph",
                  "text": "Elongation: 12%"
                },
                {
                  "type": "paragraph",
                  "text": "Tensile properties and associated requirements vary due to orientation, section thickness, and engineering requirements."
                }
              ]
            }
