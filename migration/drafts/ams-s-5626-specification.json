                {
                  "type": "heading",
                  "level": 2,
                  "text": "AMS-S-5626"
                },
                {
                  "type": "paragraph",
                  "text": "Alloy Steel Grade: AISI 4140"
                },
                {
                  "type": "paragraph",
                  "text": "Product Forms: Steel, Chrome-Molybdenum (4140) Bars, Rods, and Forging Stock (For Aircraft Applications)"
                },
                {
                  "type": "paragraph",
                  "text": "Physical conditions: Bars and rods shall be furnished in one of the following physical conditions:"
                },
                {
                  "type": "paragraph",
                  "text": "As forged"
                },
                {
                  "type": "paragraph",
                  "text": "As rolled"
                },
                {
                  "type": "paragraph",
                  "text": "Annealed"
                },
                {
                  "type": "paragraph",
                  "text": "Normalized"
                },
                {
                  "type": "paragraph",
                  "text": "Normalized and tempered"
                },
                {
                  "type": "paragraph",
                  "text": "Quenched and tempered"
                },
                {
                  "type": "paragraph",
                  "text": "Surface conditions: Bars and rods shall be furnished in one of the following surface conditions:"
                },
                {
                  "type": "paragraph",
                  "text": "Black, as forged or rolled"
                },
                {
                  "type": "paragraph",
                  "text": "Pickled or blast cleaned"
                },
                {
                  "type": "paragraph",
                  "text": "Rough turned"
                },
                {
                  "type": "paragraph",
                  "text": "Cold finished"
                },
                {
                  "type": "paragraph",
                  "text": "Turned, ground, and polished"
                },
                {
                  "type": "paragraph",
                  "text": "Product availability:"
                },
                {
                  "type": "paragraph",
                  "text": "[Alloy Steel AISI 4140 Round Bar](https://titanium.com/shop/products/mill-products-alloy-steel-round-bar)"
                },
                {
                  "type": "paragraph",
                  "text": "DISCLAIMER: The use of this information should be considered strictly voluntary. Information contained in this page or across the domain, may contain typographical errors and are for reference only. Information presented are purely generalizations and are not a substitution for AMS specifications."
                },
                {
                  "type": "paragraph",
                  "text": "Chemical Composition"
                },
                {
                  "type": "paragraph",
                  "text": "Fe 97.0%"
                },
                {
                  "type": "paragraph",
                  "text": "Cr 1.0%"
                },
                {
                  "type": "paragraph",
                  "text": "Mn 0.90%"
                },
                {
                  "type": "paragraph",
                  "text": "C 0.40%"
                },
                {
                  "type": "paragraph",
                  "text": "Si 0.25%"
                },
                {
                  "type": "paragraph",
                  "text": "Mo 0.20%"
                },
                {
                  "type": "paragraph",
                  "text": "S 0.05%"
                },
                {
                  "type": "paragraph",
                  "text": "P 0.04%"
                },
                {
                  "type": "paragraph",
                  "text": "Mechanical Properties"
                },
                {
                  "type": "paragraph",
                  "text": "Tensile Strength: 95 – 107.3 ksi"
                },
                {
                  "type": "paragraph",
                  "text": "Yield Strength: 60.2 – 95 ksi"
                },
                {
                  "type": "paragraph",
                  "text": "Elongation: 17.7 – 25.7%"
                },
                {
                  "type": "paragraph",
                  "text": "Tensile properties and associated requirements vary due to orientation, section thickness, and engineering requirements."
                }
              ]
            }
