              "blocks": [
                {
                  "type": "heading",
                  "level": 2,
                  "text": "AMS 5663"
                },
                {
                  "type": "paragraph",
                  "text": "Nickel Alloy: 718"
                },
                {
                  "type": "paragraph",
                  "text": "Product Forms: Alloy Bars, Forgings, and Rings, Corrosion and Heat Resistant Nickel Base"
                },
                {
                  "type": "paragraph",
                  "text": "Condition: Solution and Precipitation Heat Treated Consumable Electrode or Vacuum Induction Melted"
                },
                {
                  "type": "paragraph",
                  "text": "Scope: Specifies a corrosion and heat-resistant nickel alloy in the form of bars, forgings, flash welded rings up to 10 inches (254 mm) in least cross-sectional dimension, having a maximum cross-sectional area of 78 in (503 cm), and stock of any size for forging or flash welded rings."
                },
                {
                  "type": "paragraph",
                  "text": "Product availability:"
                },
                {
                  "type": "paragraph",
                  "text": "[Nickel Alloy 718 Round Bar](https://qqa.titanium.com/product/mill-product-nickel-alloy-round-bar)"
                },
                {
                  "type": "paragraph",
                  "text": "DISCLAIMER: The use of this information should be considered strictly voluntary. Information contained in this page or across the domain, may contain typographical errors and are for reference only. Information presented are purely generalizations and are not a substitution for AMS specifications."
                },
                {
                  "type": "paragraph",
                  "text": "DISCLAIMER: Alloy data sheets are for reference only, not for design purposes."
                },
                {
                  "type": "paragraph",
                  "text": "Chemical Composition"
                },
                {
                  "type": "paragraph",
                  "text": "Ni 52.5%"
                },
                {
                  "type": "paragraph",
                  "text": "Cr 19.0%"
                },
                {
                  "type": "paragraph",
                  "text": "Mo 3.05%"
                },
                {
                  "type": "paragraph",
                  "text": "C"
                },
                {
                  "type": "paragraph",
                  "text": "Nb 5.035%"
                },
                {
                  "type": "paragraph",
                  "text": "Mn"
                },
                {
                  "type": "paragraph",
                  "text": "Si"
                },
                {
                  "type": "paragraph",
                  "text": "P"
                },
                {
                  "type": "paragraph",
                  "text": "S"
                },
                {
                  "type": "paragraph",
                  "text": "Cu"
                },
                {
                  "type": "paragraph",
                  "text": "Co"
                },
                {
                  "type": "paragraph",
                  "text": "Mechanical Properties"
                },
                {
                  "type": "paragraph",
                  "text": "Tensile Strength: 14 – 220 ksi"
                },
                {
                  "type": "paragraph",
                  "text": "Yield Strength: 80 – 150 ksi"
                },
                {
                  "type": "paragraph",
                  "text": "Elongation: 18 – 27.0%"
                },
                {
                  "type": "paragraph",
                  "text": "Tensile properties and associated requirements vary due to orientation, section thickness, and engineering requirements."
                }
              ]
            }
          ]
