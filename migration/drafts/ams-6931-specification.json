                {
                  "type": "heading",
                  "level": 2,
                  "text": "AMS 6931"
                },
                {
                  "type": "paragraph",
                  "text": "Titanium Alloy: Titanium 6Al-4V Grade 5"
                },
                {
                  "type": "paragraph",
                  "text": "Product Forms: Titanium Alloy Bars, Forgings and Forging Stock"
                },
                {
                  "type": "paragraph",
                  "text": "Condition: Annealed"
                },
                {
                  "type": "paragraph",
                  "text": "Scope: This specification covers a titanium alloy in the form of bars and forgings up through 10.000 inches (254.00. mm), inclusive, in diameter or least distance between parallel sides with a maximum cross-sectional area of 79.0 in 2 (506.45 cm 2 ) and forging stock of any size."
                },
                {
                  "type": "paragraph",
                  "text": "Product availability:"
                },
                {
                  "type": "paragraph",
                  "text": "[Titanium 6Al-4V Grade 5 Round Bar](https://qqa.titanium.com/product/mill-product-titanium-round-bar)"
                },
                {
                  "type": "paragraph",
                  "text": "DISCLAIMER: The use of this information should be considered strictly voluntary. Information contained in this page or across the domain, may contain typographical errors and are for reference only. Information presented are purely generalizations and are not a substitution for AMS specifications."
                }
              ]
            },
            {
              "id": "button-15",
              "kind": "button",
              "label": "Shop Discounted Products",
              "href": "https://qqa.titanium.com/customer/discounted-products",
              "variant": "primary"
            },
            {
              "id": "text-16",
              "kind": "text",
              "blocks": [
                {
                  "type": "paragraph",
                  "text": "CHEMICAL COMPOSITION"
                },
                {
                  "type": "paragraph",
                  "text": "Al 6.25%"
                },
                {
                  "type": "paragraph",
                  "text": "V 4.00%"
                },
                {
                  "type": "paragraph",
                  "text": "C ≤ 0.8%"
                },
                {
                  "type": "paragraph",
                  "text": "N ≤ 0.05%"
                },
                {
                  "type": "paragraph",
                  "text": "O ≤ 0.20%"
                },
                {
                  "type": "paragraph",
                  "text": "H ≤ 0.0125%"
                },
                {
                  "type": "paragraph",
                  "text": "Fe ≤ 0.30%"
                },
                {
                  "type": "paragraph",
                  "text": "Y ≤ 0.005%"
                },
                {
                  "type": "paragraph",
                  "text": "Other ≤ 0.40%"
                },
                {
                  "type": "paragraph",
                  "text": "Ti Remainder"
                },
                {
                  "type": "paragraph",
                  "text": "Mechanical Properties"
                },
                {
                  "type": "paragraph",
                  "text": "Tensile Strength: 130 – 134 ksi"
                },
                {
                  "type": "paragraph",
                  "text": "Yield Strength: 120 – 126 ksi"
                },
                {
                  "type": "paragraph",
                  "text": "Elongation: 6 – 10%"
                },
                {
                  "type": "paragraph",
                  "text": "Tensile properties and associated requirements vary due to orientation, section thickness, and engineering requirements."
                }
              ]
            }
