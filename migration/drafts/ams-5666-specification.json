                {
                  "type": "paragraph",
                  "text": "Mechanical Properties"
                },
                {
                  "type": "paragraph",
                  "text": "Tensile Strength: 100 – 136 ksi"
                },
                {
                  "type": "paragraph",
                  "text": "Yield Strength: 42.1 – 66.7 ksi"
