---
import Layout from '../../layouts/Layout.astro';
import { draftSlug, loadDrafts } from '../../lib/drafts';
import type { PageDocument } from '../../../shared/page-model/types';

export function getStaticPaths() {
  return loadDrafts().map((page) => ({
    params: { slug: draftSlug(page) },
    props: { page },
  }));
}

interface Props {
  page: PageDocument;
}

const { page } = Astro.props;
const payload = JSON.stringify(page).replace(/</g, '\\u003c');
---

<Layout title={`Edit ${page.path}`} description="Private layout workspace" robots="noindex, nofollow" exactTitle>
  <div class="editor-page">
    <p class="editor-note">This preview shows the same workspace Payload uses. Changes here are not saved. Open the Payload admin to keep them.</p>
    <div id="workspace"></div>
    <script type="application/json" id="page-json" set:html={payload}></script>
  </div>
</Layout>

<script>
  import { mountWorkspace } from '../../../shared/editor/mount';
  import { parsePageDocument } from '../../../shared/page-model/schema';

  const raw = document.getElementById('page-json')?.textContent ?? '';
  const root = document.getElementById('workspace');
  if (root && raw) {
    mountWorkspace(root, parsePageDocument(JSON.parse(raw)), () => undefined);
  }
</script>

<style>
  .editor-page { padding: 96px 1rem 3rem; background: #f1f5f9; min-height: 100vh; }
  .editor-note { max-width: 1100px; margin: 0 auto 1rem; color: #003366; font-weight: 700; }
</style>
