---
import Layout from '../layouts/Layout.astro';
import StaticHero from '../components/StaticHero.astro';
import { siteChromeForPage } from '../../shared/chrome/load';
import { renderChromeHero } from '../../shared/chrome/render';

const alloyFamilies = [
  {
    icon: '⬡',
    name: 'Titanium',
    desc: 'Exceptional strength-to-weight ratio for aerospace and medical applications. Grades 1–38, Ti-6Al-4V, ELI, and more.',
    href: '/alloys/titanium',
    highlight: 'Aerospace & Medical',
  },
  {
    icon: '◈',
    name: 'Nickel Alloys',
    desc: 'Superior corrosion and oxidation resistance for extreme temperature environments. Inconel, Hastelloy, Waspaloy.',
    href: '/alloys/nickel',
    highlight: 'High Temperature',
  },
  {
    icon: '◇',
    name: 'Stainless Steel',
    desc: 'Versatile alloys balancing corrosion resistance, formability, and strength for industrial and medical applications.',
    href: '/alloys/stainless-steel',
    highlight: 'Industrial & Medical',
  },
  {
    icon: '△',
    name: 'Aluminum',
    desc: 'Lightweight, highly formable alloys for aerospace structures, tooling, and precision machined components.',
    href: '/alloys/aluminum',
    highlight: 'Aerospace Structures',
  },
  {
    icon: '□',
    name: 'Carbon Steel',
    desc: 'High-strength structural and tool steel alloys for demanding industrial applications and tooling.',
    href: '/alloys/carbon-steel',
    highlight: 'Structural & Tooling',
  },
  {
    icon: '◎',
    name: 'Cobalt Chrome',
    desc: 'Biocompatible, wear-resistant alloys for medical implants, aerospace turbine components, and dental applications.',
    href: '/alloys/cobalt-chrome',
    highlight: 'Medical Implants',
  },
];

const services = [
  { icon: '◈', title: 'Precision Sawing', desc: 'Tight-tolerance bar and plate cutting to ±0.010" standard. High-speed cold saws for all alloy families.' },
  { icon: '≋', title: 'Waterjet Cutting', desc: 'Complex 2D profiles in any thickness with no heat-affected zone. Ideal for titanium and nickel alloys.' },
  { icon: '◉', title: 'Heat Treating', desc: 'In-house annealing, stress relieving, and solution treating with certified furnaces and documentation.' },
  { icon: '◐', title: 'Surface Finishing', desc: 'Precision grinding, lapping, polishing, and specialty surface preparation to meet exacting requirements.' },
  { icon: '◑', title: 'Quality Testing', desc: 'In-house ultrasonic, hardness, and chemistry verification. Full DFARS compliance and material traceability.' },
  { icon: '⊠', title: 'Custom Packaging', desc: 'Protect-in-place packaging for aerospace-grade material. VCI, foam, and custom crating available.' },
];

const markets = [
  { icon: '✈', name: 'Aerospace & Defense', desc: 'Qualified source for AS9100D materials serving commercial and military airframe programs.' },
  { icon: '⚕', name: 'Medical & Dental', desc: 'ISO 10993 compatible alloys for orthopedic implants, surgical instruments, and dental prosthetics.' },
  { icon: '⛽', name: 'Oil & Gas', desc: 'Corrosion-resistant alloys for downhole tools, subsea equipment, and refinery applications.' },
  { icon: '⚡', name: 'Power Generation', desc: 'High-temperature alloys for turbine components, heat exchangers, and pressure vessels.' },
  { icon: '⚓', name: 'Marine', desc: 'Seawater-resistant titanium and nickel alloys for naval, offshore, and commercial marine structures.' },
  { icon: '⚙', name: 'Industrial Mfg.', desc: 'Precision-cut stock for tooling, fixtures, pumps, valves, and precision machined components.' },
];

const locations = [
  'Rockaway, NJ', 'Jacksonville, FL', 'Garden Grove, CA', 'Woodinville, WA',
  'Naperville, IL', 'Plymouth, MI', 'Tolland, CT', 'St. Laurent, Canada',
  'Birmingham, UK', 'Meerbusch, Germany', 'Flévy, France', 'Verona, Italy',
  'Shanghai, China', 'Taipei, Taiwan', 'Penang, Malaysia', 'Bengaluru, India',
  'León, Mexico', 'São Paulo, Brazil',
];

const newsArticles = [
  {
    category: 'Technical Guide',
    categoryColor: '#10b981',
    date: 'Mar 2026',
    title: 'Understanding AMS 4928 Grade 5 Titanium Specifications',
    excerpt: 'A deep dive into the mechanical and chemical requirements of AMS 4928 — the aerospace standard for Ti-6Al-4V bar, billet, and plate.',
    href: '/blog/ams-4928-grade-5-titanium',
    readTime: '8 min read',
  },
  {
    category: 'Company News',
    categoryColor: '#2563eb',
    date: 'Feb 2026',
    title: 'Titanium Industries Expands Montreal Service Center Capacity',
    excerpt: 'A $4.2M investment in new precision sawing and waterjet equipment doubles throughput at our Montreal facility.',
    href: '/blog/montreal-expansion',
    readTime: '3 min read',
  },
  {
    category: 'Technical Guide',
    categoryColor: '#10b981',
    date: 'Jan 2026',
    title: 'Guide to Selecting Nickel Alloys for High-Temperature Applications',
    excerpt: 'Inconel 625 vs. 718 vs. Hastelloy X — a practical framework for choosing the right nickel alloy above 800°F.',
    href: '/blog/nickel-alloy-selection',
    readTime: '10 min read',
  },
];

const trustStats = [
  { value: '53', label: 'Years Experience' },
  { value: '20+', label: 'Global Locations' },
  { value: '5,000+', label: 'Alloys Stocked' },
  { value: '24hr', label: 'Quote Turnaround' },
];

const chrome = siteChromeForPage({
  dev: import.meta.env.DEV,
  pathname: Astro.url.pathname,
});
const chromeHero = chrome ? renderChromeHero(chrome) : '';
---

<Layout
  title="Specialty Metals Distributor"
  description="Titanium Industries — The world's most trusted source for specialty metals. Titanium, nickel, stainless steel, aluminum, carbon steel, and cobalt chrome with 20+ global service centers and same-day shipping."
>

  {chromeHero ? <Fragment set:html={chromeHero} /> : <StaticHero trustStats={trustStats} />}


  <!-- Section divider -->
  <div style="height: 1px; background: linear-gradient(90deg, transparent, #e2e8f0, transparent);"></div>

  <!-- ===================== ALLOY FAMILIES ===================== -->
  <section style="background: #ffffff; padding: 6rem 0;">
    <div style="max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;">

      <!-- Section header -->
      <div style="text-align: center; margin-bottom: 3.5rem;">
        <div style="display: inline-block; padding: 0.35rem 1rem; background: rgba(0,51,102,0.06); border: 1px solid rgba(0,51,102,0.15); border-radius: 100px; font-size: 0.75rem; font-weight: 700; color: #003366; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem;">
          Materials
        </div>
        <h2 style="font-size: clamp(1.75rem, 3vw, 2.75rem); font-weight: 800; color: #1f2937; margin-bottom: 1rem;">
          Materials We Distribute
        </h2>
        <p style="font-size: 1rem; color: #4b5563; max-width: 520px; margin: 0 auto;">
          Over 5,000 alloys in stock across six material families. Same-day shipping available on standard stock items.
        </p>
      </div>

      <!-- Alloy grid -->
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;">
        {alloyFamilies.map(alloy => (
          <a
            href={alloy.href}
            style="display: block; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.75rem; text-decoration: none; transition: all 0.3s; position: relative; overflow: hidden;"
            onmouseenter="this.style.borderColor='#003366'; this.style.transform='translateY(-3px)'; this.style.boxShadow='0 12px 32px rgba(0,51,102,0.1)'"
            onmouseleave="this.style.borderColor='#e2e8f0'; this.style.transform='translateY(0)'; this.style.boxShadow='none'"
          >
            <!-- Icon -->
            <div style="font-size: 1.75rem; color: #003366; margin-bottom: 1rem; opacity: 0.9;">{alloy.icon}</div>

            <!-- Highlight badge -->
            <div style="display: inline-block; padding: 0.2rem 0.625rem; background: rgba(0,51,102,0.06); border-radius: 4px; font-size: 0.65rem; font-weight: 700; color: #003366; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 0.75rem;">
              {alloy.highlight}
            </div>

            <h3 style="font-size: 1.1rem; font-weight: 700; color: #1f2937; margin-bottom: 0.625rem;">{alloy.name}</h3>
            <p style="font-size: 0.875rem; color: #4b5563; line-height: 1.6; margin-bottom: 1.25rem;">{alloy.desc}</p>

            <div style="display: flex; align-items: center; gap: 0.375rem; font-size: 0.8rem; font-weight: 600; color: #1e4d8c;">
              View Alloys
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Section divider -->
  <div style="height: 1px; background: linear-gradient(90deg, transparent, #e2e8f0, transparent);"></div>

  <!-- ===================== PRODUCTS / FORMS ===================== -->
  <section style="background: #f8f9fa; padding: 5rem 0;">
    <div style="max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;">

      <div style="text-align: center; margin-bottom: 3rem;">
        <div style="display: inline-block; padding: 0.35rem 1rem; background: rgba(0,51,102,0.06); border: 1px solid rgba(0,51,102,0.15); border-radius: 100px; font-size: 0.75rem; font-weight: 700; color: #003366; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem;">
          Products
        </div>
        <h2 style="font-size: clamp(1.75rem, 3vw, 2.75rem); font-weight: 800; color: #1f2937; margin-bottom: 0.75rem;">
          Full Line of Multi-Metals
        </h2>
        <p style="font-size: 1rem; color: #4b5563; max-width: 580px; margin: 0 auto;">
          Complete inventory of mill products across all forms — from round bar and plate to pipe, fittings, and precision cut stock.
        </p>
      </div>

      <!-- Mill Products -->
      <div style="margin-bottom: 2rem;">
        <h3 style="font-size: 0.75rem; font-weight: 700; color: #003366; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #e2e8f0;">Mill Products</h3>
        <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.75rem;">
          {['Round Bar', 'Rectangle Bar', 'Hollow Bar', 'Hex Bar', 'Plate', 'Sheet', 'Block', 'Billet', 'Wire / Coil', 'Expanded Metal'].map(form => (
            <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem 0.875rem; text-align: center; transition: all 0.2s;"
              onmouseenter="this.style.borderColor='#003366'; this.style.boxShadow='0 4px 12px rgba(0,51,102,0.08)'"
              onmouseleave="this.style.borderColor='#e2e8f0'; this.style.boxShadow='none'"
            >
              <div style="font-size: 0.875rem; font-weight: 600; color: #1f2937;">{form}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Pipe & Fittings -->
      <div style="margin-bottom: 2.5rem;">
        <h3 style="font-size: 0.75rem; font-weight: 700; color: #003366; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid #e2e8f0;">Pipe & Fittings</h3>
        <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.75rem;">
          {['Seamless Pipe', 'Welded Pipe', 'Seamless Tube', 'Welded Tube', 'Flanges', 'Elbows 45° & 90°', 'Tees', 'Stub Ends', 'Concentric Reducers', 'Eccentric Reducers'].map(form => (
            <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem 0.875rem; text-align: center; transition: all 0.2s;"
              onmouseenter="this.style.borderColor='#003366'; this.style.boxShadow='0 4px 12px rgba(0,51,102,0.08)'"
              onmouseleave="this.style.borderColor='#e2e8f0'; this.style.boxShadow='none'"
            >
              <div style="font-size: 0.875rem; font-weight: 600; color: #1f2937;">{form}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- CTAs -->
      <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center;">
        <a href="/contact" style="padding: 0.75rem 2rem; background: #003366; color: #ffffff; font-size: 0.9rem; font-weight: 700; border-radius: 8px; text-decoration: none; transition: background 0.2s;"
          onmouseenter="this.style.background='#1e4d8c'"
          onmouseleave="this.style.background='#003366'"
        >Create Quote</a>
        <a href="/contact#rfq" style="padding: 0.75rem 2rem; background: #ffffff; color: #003366; font-size: 0.9rem; font-weight: 700; border-radius: 8px; text-decoration: none; border: 1.5px solid #003366; transition: all 0.2s;"
          onmouseenter="this.style.background='rgba(0,51,102,0.05)'"
          onmouseleave="this.style.background='#ffffff'"
        >Submit RFQ</a>
        <a href="/alloys/titanium" style="padding: 0.75rem 2rem; background: #ffffff; color: #003366; font-size: 0.9rem; font-weight: 700; border-radius: 8px; text-decoration: none; border: 1.5px solid #003366; transition: all 0.2s;"
          onmouseenter="this.style.background='rgba(0,51,102,0.05)'"
          onmouseleave="this.style.background='#ffffff'"
        >Browse Alloys</a>
      </div>

    </div>
  </section>

  <!-- Section divider -->
  <div style="height: 1px; background: linear-gradient(90deg, transparent, #e2e8f0, transparent);"></div>

  <!-- ===================== SERVICES ===================== -->
  <section style="background: #f8f9fa; padding: 6rem 0;">
    <div style="max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;">

      <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; align-items: start;">

        <!-- Left: photo + header -->
        <div style="position: sticky; top: 100px;">
          <!-- Real waterjet photo -->
          <div style="border-radius: 12px; overflow: hidden; margin-bottom: 1.75rem; box-shadow: 0 8px 32px rgba(0,0,0,0.12);">
            <img
              src="/images/waterjet.jpg"
              alt="Waterjet cutting precision metals"
              style="width: 100%; height: 220px; object-fit: cover; display: block;"
              loading="lazy"
            />
          </div>

          <div style="display: inline-block; padding: 0.35rem 1rem; background: rgba(0,51,102,0.06); border: 1px solid rgba(0,51,102,0.15); border-radius: 100px; font-size: 0.75rem; font-weight: 700; color: #003366; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem;">
            Services
          </div>
          <h2 style="font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 800; color: #1f2937; margin-bottom: 1rem; line-height: 1.15;">
            Value-Added Services
          </h2>
          <p style="font-size: 0.95rem; color: #4b5563; line-height: 1.7; margin-bottom: 2rem;">
            Beyond distribution — full-service processing at every location. Receive material cut, treated, and tested to your exact specification.
          </p>
          <a href="/services" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: #003366; color: #ffffff; font-size: 0.875rem; font-weight: 700; border-radius: 8px; text-decoration: none; transition: all 0.2s;"
            onmouseenter="this.style.background='#1e4d8c'"
            onmouseleave="this.style.background='#003366'"
          >
            All Services
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Right: service cards grid -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          {services.map(service => (
            <div
              style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 1.5rem; transition: all 0.3s;"
              onmouseenter="this.style.borderColor='#003366'; this.style.boxShadow='0 4px 16px rgba(0,51,102,0.08)'"
              onmouseleave="this.style.borderColor='#e2e8f0'; this.style.boxShadow='none'"
            >
              <div style="font-size: 1.25rem; color: #003366; margin-bottom: 0.875rem;">{service.icon}</div>
              <h3 style="font-size: 0.95rem; font-weight: 700; color: #1f2937; margin-bottom: 0.5rem;">{service.title}</h3>
              <p style="font-size: 0.825rem; color: #4b5563; line-height: 1.6;">{service.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Section divider -->
  <div style="height: 1px; background: linear-gradient(90deg, transparent, #e2e8f0, transparent);"></div>

  <!-- ===================== MARKETS ===================== -->
  <section style="background: #ffffff; padding: 6rem 0;">
    <div style="max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;">

      <div style="text-align: center; margin-bottom: 3.5rem;">
        <div style="display: inline-block; padding: 0.35rem 1rem; background: rgba(0,51,102,0.06); border: 1px solid rgba(0,51,102,0.15); border-radius: 100px; font-size: 0.75rem; font-weight: 700; color: #003366; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem;">
          Markets
        </div>
        <h2 style="font-size: clamp(1.75rem, 3vw, 2.75rem); font-weight: 800; color: #1f2937; margin-bottom: 1rem;">
          Industries We Serve
        </h2>
        <p style="font-size: 1rem; color: #4b5563; max-width: 520px; margin: 0 auto;">
          Specialty metals expertise spanning the most demanding industries on the planet.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;">
        {markets.map(market => (
          <div
            style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 2rem 1.75rem; transition: all 0.3s; cursor: default;"
            onmouseenter="this.style.borderColor='#003366'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 24px rgba(0,51,102,0.08)'"
            onmouseleave="this.style.borderColor='#e2e8f0'; this.style.transform='translateY(0)'; this.style.boxShadow='none'"
          >
            <div style="font-size: 1.75rem; margin-bottom: 1rem;">{market.icon}</div>
            <h3 style="font-size: 1rem; font-weight: 700; color: #1f2937; margin-bottom: 0.5rem;">{market.name}</h3>
            <p style="font-size: 0.85rem; color: #4b5563; line-height: 1.6;">{market.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section divider -->
  <div style="height: 1px; background: linear-gradient(90deg, transparent, #e2e8f0, transparent);"></div>

  <!-- ===================== GLOBAL PRESENCE ===================== -->
  <section style="background: #f8f9fa; padding: 6rem 0;">
    <div style="max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;">

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">

        <!-- Left: content -->
        <div>
          <div style="display: inline-block; padding: 0.35rem 1rem; background: rgba(0,51,102,0.06); border: 1px solid rgba(0,51,102,0.15); border-radius: 100px; font-size: 0.75rem; font-weight: 700; color: #003366; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem;">
            Global Presence
          </div>
          <h2 style="font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 800; color: #1f2937; margin-bottom: 1rem;">
            20+ Locations Worldwide
          </h2>
          <p style="font-size: 0.95rem; color: #4b5563; line-height: 1.7; margin-bottom: 2rem;">
            With service centers across North America, Europe, and Asia-Pacific, we deliver the right material to your facility faster than any other specialty metals distributor.
          </p>

          <!-- Location pills -->
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            {locations.map(loc => (
              <span style="padding: 0.375rem 0.875rem; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 100px; font-size: 0.78rem; color: #4b5563; font-weight: 500; transition: all 0.2s;"
                onmouseenter="this.style.borderColor='#003366'; this.style.color='#003366'; this.style.background='rgba(0,51,102,0.04)'"
                onmouseleave="this.style.borderColor='#e2e8f0'; this.style.color='#4b5563'; this.style.background='#ffffff'"
              >
                {loc}
              </span>
            ))}
          </div>
        </div>

        <!-- Right: real global network image -->
        <div style="position: relative;">
          <div style="border-radius: 16px; overflow: hidden; box-shadow: 0 16px 48px rgba(0,0,0,0.15); border: 1px solid #e2e8f0;">
            <img
              src="/images/global-network.jpg"
              alt="Titanium Industries global supply network"
              style="width: 100%; height: 320px; object-fit: cover; display: block;"
              loading="lazy"
            />
          </div>

          <!-- Stat bar below image -->
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 1rem; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; background: #ffffff; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
            <div style="padding: 1.25rem 1rem; text-align: center; border-right: 1px solid #e2e8f0;">
              <div style="font-size: 1.75rem; font-weight: 900; color: #003366; line-height: 1; margin-bottom: 0.25rem;">20+</div>
              <div style="font-size: 0.7rem; color: #64748b; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em;">Locations</div>
            </div>
            <div style="padding: 1.25rem 1rem; text-align: center; border-right: 1px solid #e2e8f0;">
              <div style="font-size: 1.75rem; font-weight: 900; color: #003366; line-height: 1; margin-bottom: 0.25rem;">24/7</div>
              <div style="font-size: 0.7rem; color: #64748b; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em;">Operations</div>
            </div>
            <div style="padding: 1.25rem 1rem; text-align: center;">
              <div style="font-size: 1.75rem; font-weight: 900; color: #003366; line-height: 1; margin-bottom: 0.25rem;">98%</div>
              <div style="font-size: 0.7rem; color: #64748b; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em;">On-Time Delivery</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section divider -->
  <div style="height: 1px; background: linear-gradient(90deg, transparent, #e2e8f0, transparent);"></div>

  <!-- ===================== BLOG / NEWS ===================== -->
  <section style="background: #ffffff; padding: 6rem 0;">
    <div style="max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;">

      <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 3rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <div style="display: inline-block; padding: 0.35rem 1rem; background: rgba(0,51,102,0.06); border: 1px solid rgba(0,51,102,0.15); border-radius: 100px; font-size: 0.75rem; font-weight: 700; color: #003366; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem;">
            Resources
          </div>
          <h2 style="font-size: clamp(1.75rem, 3vw, 2.75rem); font-weight: 800; color: #1f2937;">
            Latest News & Resources
          </h2>
        </div>
        <a href="/blog" style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 600; color: #1e4d8c; text-decoration: none; white-space: nowrap;"
          onmouseenter="this.style.textDecoration='underline'"
          onmouseleave="this.style.textDecoration='none'"
        >
          All Articles
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
