---
import Layout from '../layouts/Layout.astro';
import StaticHero from '../components/StaticHero.astro';
import StaticHomeBelow from '../components/StaticHomeBelow.astro';
import { siteChromeForPage } from '../../shared/chrome/load';
import { renderChromeHero } from '../../shared/chrome/render';
import { homepageSectionsHtml, loadHomepageDraft } from '../../shared/homepage/load';

const trustStats = [
  { value: '53', label: 'Years Experience' },
  { value: '20+', label: 'Global Locations' },
  { value: '5,000+', label: 'Alloys Stocked' },
  { value: '24hr', label: 'Quote Turnaround' },
];

const chromeContext = {
  dev: import.meta.env.DEV,
  pathname: Astro.url.pathname,
};
const chrome = siteChromeForPage(chromeContext);
const chromeHero = chrome ? renderChromeHero(chrome) : '';
const homeDraft = loadHomepageDraft();
const homeSections = homepageSectionsHtml(chromeContext);
const showHomeSections = Boolean(homeSections && homeDraft);
---

<Layout
  title={showHomeSections && homeDraft ? homeDraft.seo.title : 'Specialty Metals Distributor'}
  description={showHomeSections && homeDraft ? homeDraft.seo.description : "Titanium Industries — The world's most trusted source for specialty metals. Titanium, nickel, stainless steel, aluminum, carbon steel, and cobalt chrome with 20+ global service centers and same-day shipping."}
  exactTitle={showHomeSections}
  canonical={showHomeSections && homeDraft ? homeDraft.seo.canonical : undefined}
  ogTitle={showHomeSections && homeDraft ? homeDraft.seo.ogTitle : undefined}
  ogDescription={showHomeSections && homeDraft ? homeDraft.seo.ogDescription : undefined}
  ogImage={showHomeSections && homeDraft && homeDraft.seo.ogImage ? homeDraft.seo.ogImage : '/og-default.jpg'}
>

  {chromeHero ? <Fragment set:html={chromeHero} /> : <StaticHero trustStats={trustStats} />}

  {homeSections ? <Fragment set:html={homeSections} /> : <StaticHomeBelow />}

</Layout>

