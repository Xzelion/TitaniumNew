---
import Layout from '../../layouts/Layout.astro';

const posts = [
  {
    id: 1,
    slug: 'ams-4928-grade-5-titanium',
    category: 'Technical Guide',
    categoryColor: '#10b981',
    date: 'March 15, 2026',
    readTime: '8 min read',
    author: 'James Hartley',
    authorTitle: 'Materials Engineer',
    title: 'Understanding AMS 4928 Grade 5 Titanium Specifications',
    excerpt: 'A comprehensive look at the mechanical properties, chemical requirements, and application considerations for AMS 4928 Ti-6Al-4V — the aerospace standard for titanium bar, billet, and plate.',
    tags: ['Titanium', 'AMS 4928', 'Ti-6Al-4V', 'Aerospace'],
    group: 'technical',
  },
  {
    id: 2,
    slug: 'montreal-expansion',
    category: 'Company News',
    categoryColor: '#2563eb',
    date: 'February 8, 2026',
    readTime: '3 min read',
    author: 'Communications Team',
    authorTitle: 'Titanium Industries',
    title: 'Titanium Industries Expands Montreal Service Center Capacity',
    excerpt: 'A $4.2M capital investment in new precision sawing and waterjet equipment doubles processing throughput at our Montreal, Canada facility — reducing lead times across Eastern Canada and the Northeast US.',
    tags: ['Montreal', 'Expansion', 'Waterjet', 'Precision Sawing'],
    group: 'news',
  },
  {
    id: 3,
    slug: 'nickel-alloy-selection',
    category: 'Technical Guide',
    categoryColor: '#10b981',
    date: 'January 22, 2026',
    readTime: '10 min read',
    author: 'Dr. Sarah Chen',
    authorTitle: 'Sr. Metallurgist',
    title: 'Guide to Selecting Nickel Alloys for High-Temperature Applications',
    excerpt: 'Inconel 625 vs. 718 vs. Hastelloy X — understanding the microstructural differences and practical framework for selecting the right nickel superalloy for service above 800°F.',
    tags: ['Nickel', 'Inconel', 'Hastelloy', 'High Temperature'],
    group: 'technical',
  },
  {
    id: 4,
    slug: 'ti-6al-4v-vs-eli',
    category: 'Technical Guide',
    categoryColor: '#10b981',
    date: 'January 10, 2026',
    readTime: '6 min read',
    author: 'James Hartley',
    authorTitle: 'Materials Engineer',
    title: 'How to Choose Between Ti-6Al-4V and Ti-6Al-4V ELI',
    excerpt: 'Grade 5 vs. Grade 23: When does the reduced interstitial content of ELI matter, and when can you use standard Grade 5? A practical decision guide for engineers specifying titanium for biomedical applications.',
    tags: ['Titanium', 'Grade 5', 'Grade 23', 'Medical'],
    group: 'technical',
  },
  {
    id: 5,
    slug: 'rockaway-waterjet',
    category: 'Company News',
    categoryColor: '#2563eb',
    date: 'December 5, 2025',
    readTime: '4 min read',
    author: 'Communications Team',
    authorTitle: 'Titanium Industries',
    title: 'New Waterjet Cutting Capabilities at Rockaway Facility',
    excerpt: 'Our Rockaway, NJ location has commissioned a new 5-axis waterjet system with a 12\' × 8\' cutting envelope, enabling complex 3D profiling of titanium and nickel alloy parts up to 12" thick.',
    tags: ['Rockaway', 'Waterjet', 'Services', 'New Equipment'],
    group: 'news',
  },
  {
    id: 6,
    slug: 'cobalt-chrome-medical',
    category: 'Technical Guide',
    categoryColor: '#10b981',
    date: 'November 18, 2025',
    readTime: '9 min read',
    author: 'Dr. Sarah Chen',
    authorTitle: 'Sr. Metallurgist',
    title: 'Cobalt Chrome Alloys in Medical Device Manufacturing',
    excerpt: 'From hip and knee replacements to dental prosthetics, cobalt-chromium alloys deliver the wear resistance and biocompatibility that titanium cannot. A deep dive into L-605, MP35N, and ASTM F75 grades.',
    tags: ['Cobalt Chrome', 'Medical', 'Biocompatible', 'L-605'],
    group: 'technical',
  },
];

const categories = [
  { id: 'all', label: 'All Articles', count: posts.length },
  { id: 'technical', label: 'Technical Guides', count: posts.filter(p => p.group === 'technical').length },
  { id: 'news', label: 'Industry News', count: posts.filter(p => p.group === 'news').length },
];
---

<Layout
  title="Resources & Technical Guides"
  description="Technical guides, industry news, and materials engineering resources from Titanium Industries. AMS specifications, alloy selection guides, and company updates."
>

  <!-- Hero — dark navy -->
  <section style="background: linear-gradient(135deg, #1b2060 0%, #142050 60%, #1b2060 100%); padding: 4rem 0 3rem; position: relative; overflow: hidden;">
    <div style="position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 60px 60px;"></div>

    <div style="max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; position: relative;">
      <nav style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem; font-size: 0.8rem;">
        <a href="/" style="color: #64748b; text-decoration: none;">Home</a>
        <span style="color: #64748b;">/</span>
        <span style="color: #93c5fd;">Resources</span>
      </nav>

      <div style="max-width: 680px;">
        <div style="display: inline-block; padding: 0.35rem 1rem; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); border-radius: 100px; font-size: 0.75rem; font-weight: 700; color: #e2e8f0; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem;">
          Knowledge Base
        </div>
        <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; color: #ffffff; margin-bottom: 1rem; line-height: 1.1;">
          Resources & Technical Guides
        </h1>
        <p style="font-size: 1rem; color: #94a3b8; line-height: 1.7;">
          Alloy selection guides, AMS specification breakdowns, application case studies, and company news from the Titanium Industries technical team.
        </p>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div style="height: 1px; background: linear-gradient(90deg, transparent, #e2e8f0, transparent);"></div>

  <!-- Content — white background -->
  <section style="background: #ffffff; padding: 4rem 0;">
    <div style="max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;">

      <!-- Category tabs -->
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 3rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0; flex-wrap: wrap;">
        {categories.map((cat, i) => (
          <button
            data-category={cat.id}
            class="cat-btn"
            style={`padding: 0.75rem 1.25rem; font-size: 0.875rem; font-weight: 600; border: none; cursor: pointer; transition: all 0.2s; background: transparent; border-bottom: 2px solid; margin-bottom: -1px; display: flex; align-items: center; gap: 0.5rem; ${i === 0 ? 'color: #003366; border-bottom-color: #003366;' : 'color: #6b7280; border-bottom-color: transparent;'}`}
          >
            {cat.label}
            <span style={`padding: 0.15rem 0.5rem; border-radius: 100px; font-size: 0.7rem; font-weight: 700; ${i === 0 ? 'background: rgba(0,51,102,0.08); color: #003366;' : 'background: #f3f4f6; color: #6b7280;'}`}>
              {cat.count}
            </span>
          </button>
        ))}
      </div>

      <!-- Featured post (first) -->
      <div id="featured-post" data-group={posts[0].group} class="post-card" style="margin-bottom: 2rem;">
        <a href={`/blog/${posts[0].slug}`} style="display: grid; grid-template-columns: 1fr 1fr; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; text-decoration: none; transition: all 0.3s; box-shadow: 0 2px 8px rgba(0,0,0,0.04);"
          onmouseenter="this.style.borderColor='#003366'; this.style.boxShadow='0 12px 40px rgba(0,51,102,0.1)'"
          onmouseleave="this.style.borderColor='#e2e8f0'; this.style.boxShadow='0 2px 8px rgba(0,0,0,0.04)'"
        >
          <!-- Visual -->
          <div style="background: linear-gradient(135deg, #1b2060, #1e3a5f); display: flex; align-items: center; justify-content: center; min-height: 280px; position: relative; overflow: hidden; border-right: 1px solid #e2e8f0;">
            <div style="position: absolute; top: -40px; right: -40px; width: 200px; height: 200px; border: 1px solid rgba(255,255,255,0.08); border-radius: 50%;"></div>
            <div style="position: absolute; bottom: -40px; left: -40px; width: 160px; height: 160px; border: 1px solid rgba(255,255,255,0.06); border-radius: 50%;"></div>
            <div style="text-align: center; position: relative; z-index: 1;">
              <div style="font-size: 4rem; opacity: 0.3; margin-bottom: 0.75rem; color: #ffffff;">📐</div>
              <div style="font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.3); font-weight: 700;">Featured Article</div>
            </div>
          </div>
          <!-- Content -->
          <div style="padding: 2.5rem 2rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
              <span style={`padding: 0.25rem 0.75rem; background: ${posts[0].categoryColor}18; border: 1px solid ${posts[0].categoryColor}40; border-radius: 4px; font-size: 0.7rem; font-weight: 700; color: ${posts[0].categoryColor}; letter-spacing: 0.05em; text-transform: uppercase;`}>
                {posts[0].category}
              </span>
              <span style="font-size: 0.8rem; color: #6b7280;">{posts[0].date}</span>
              <span style="font-size: 0.8rem; color: #6b7280;">{posts[0].readTime}</span>
            </div>
            <h2 style="font-size: 1.4rem; font-weight: 800; color: #1f2937; line-height: 1.3; margin-bottom: 1rem;">{posts[0].title}</h2>
            <p style="font-size: 0.9rem; color: #4b5563; line-height: 1.7; margin-bottom: 1.5rem;">{posts[0].excerpt}</p>
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
              <div style="display: flex; align-items: center; gap: 0.625rem;">
                <div style="width: 32px; height: 32px; background: #003366; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 800; color: #ffffff;">JH</div>
                <div>
                  <div style="font-size: 0.8rem; font-weight: 600; color: #1f2937;">{posts[0].author}</div>
                  <div style="font-size: 0.72rem; color: #6b7280;">{posts[0].authorTitle}</div>
                </div>
              </div>
              <div style="display: flex; align-items: center; gap: 0.375rem; font-size: 0.85rem; font-weight: 700; color: #1e4d8c;">
                Read Article
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
            </div>
          </div>
        </a>
      </div>

      <!-- Post grid -->
      <div id="posts-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
        {posts.slice(1).map(post => (
          <div class="post-card" data-group={post.group}>
            <a
              href={`/blog/${post.slug}`}
              style="display: flex; flex-direction: column; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; text-decoration: none; transition: all 0.3s; height: 100%;"
              onmouseenter="this.style.borderColor='#003366'; this.style.transform='translateY(-3px)'; this.style.boxShadow='0 12px 32px rgba(0,51,102,0.1)'"
              onmouseleave="this.style.borderColor='#e2e8f0'; this.style.transform='translateY(0)'; this.style.boxShadow='none'"
            >
              <!-- Visual header -->
              <div style="height: 100px; background: linear-gradient(135deg, #1b2060, #1e3a5f); display: flex; align-items: center; justify-content: center; border-bottom: 1px solid #e2e8f0; position: relative; overflow: hidden;">
                <div style="position: absolute; top: -20px; right: -20px; width: 80px; height: 80px; border: 1px solid rgba(255,255,255,0.08); border-radius: 50%;"></div>
                <span style="font-size: 2rem; opacity: 0.35; color: #ffffff;">{post.group === 'technical' ? '📐' : '📢'}</span>
              </div>

              <div style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column;">
                <div style="display: flex; align-items: center; gap: 0.625rem; margin-bottom: 0.875rem; flex-wrap: wrap;">
                  <span style={`padding: 0.2rem 0.625rem; background: ${post.categoryColor}18; border: 1px solid ${post.categoryColor}40; border-radius: 4px; font-size: 0.65rem; font-weight: 700; color: ${post.categoryColor}; text-transform: uppercase; letter-spacing: 0.04em;`}>
                    {post.category}
                  </span>
                  <span style="font-size: 0.75rem; color: #6b7280;">{post.date}</span>
                </div>

                <h3 style="font-size: 1rem; font-weight: 700; color: #1f2937; line-height: 1.4; margin-bottom: 0.75rem; flex: 1;">{post.title}</h3>
                <p style="font-size: 0.825rem; color: #4b5563; line-height: 1.6; margin-bottom: 1.25rem;">{post.excerpt}</p>

                <div style="display: flex; align-items: center; justify-content: space-between; margin-top: auto; flex-wrap: wrap; gap: 0.5rem;">
                  <span style="font-size: 0.75rem; color: #6b7280;">{post.readTime}</span>
                  <div style="display: flex; align-items: center; gap: 0.375rem; font-size: 0.8rem; font-weight: 700; color: #1e4d8c;">
                    Read More
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </div>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>

      <!-- Pagination placeholder -->
      <div style="display: flex; justify-content: center; margin-top: 3rem; gap: 0.5rem;">
        <span style="padding: 0.5rem 1rem; background: #003366; color: #ffffff; border-radius: 6px; font-size: 0.875rem; font-weight: 700;">1</span>
        <a href="#" style="padding: 0.5rem 1rem; background: #ffffff; border: 1px solid #e2e8f0; color: #4b5563; border-radius: 6px; font-size: 0.875rem; text-decoration: none; transition: all 0.2s;"
          onmouseenter="this.style.borderColor='#003366'; this.style.color='#003366'"
          onmouseleave="this.style.borderColor='#e2e8f0'; this.style.color='#4b5563'"
        >2</a>
        <a href="#" style="padding: 0.5rem 1rem; background: #ffffff; border: 1px solid #e2e8f0; color: #4b5563; border-radius: 6px; font-size: 0.875rem; text-decoration: none; transition: all 0.2s;"
          onmouseenter="this.style.borderColor='#003366'; this.style.color='#003366'"
          onmouseleave="this.style.borderColor='#e2e8f0'; this.style.color='#4b5563'"
        >3</a>
        <span style="padding: 0.5rem 0.5rem; color: #9ca3af; font-size: 0.875rem;">···</span>
        <a href="#" style="display: flex; align-items: center; gap: 0.375rem; padding: 0.5rem 1rem; background: #ffffff; border: 1px solid #e2e8f0; color: #4b5563; border-radius: 6px; font-size: 0.875rem; text-decoration: none; transition: all 0.2s;"
          onmouseenter="this.style.borderColor='#003366'; this.style.color='#003366'"
          onmouseleave="this.style.borderColor='#e2e8f0'; this.style.color='#4b5563'"
        >
          Next
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

</Layout>

<script>
  const catBtns = document.querySelectorAll('.cat-btn') as NodeListOf<HTMLButtonElement>;
  const postCards = document.querySelectorAll('.post-card') as NodeListOf<HTMLElement>;

  catBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.category;

      // Update tab styles
      catBtns.forEach(b => {
        b.style.color = '#6b7280';
        b.style.borderBottomColor = 'transparent';
        const badge = b.querySelector('span') as HTMLElement | null;
        if (badge) {
          badge.style.background = '#f3f4f6';
          badge.style.color = '#6b7280';
        }
      });
      btn.style.color = '#003366';
      btn.style.borderBottomColor = '#003366';
      const activeBadge = btn.querySelector('span') as HTMLElement | null;
      if (activeBadge) {
        activeBadge.style.background = 'rgba(0,51,102,0.08)';
        activeBadge.style.color = '#003366';
      }

      // Filter posts
      postCards.forEach(card => {
        if (cat === 'all' || card.dataset.group === cat) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  @media (max-width: 900px) {
    #posts-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
    a[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
  @media (max-width: 600px) {
    #posts-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
